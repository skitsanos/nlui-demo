{
  "name": "nlui-demo",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "compile": "bun build --compile --production src/index.ts src/data/queryWorker.ts --outfile dist/demo",
    "lint": "bunx biome check src/ scripts/ tests/",
    "lint:fix": "bunx biome check src/ scripts/ tests/ --fix",
    "seed": "bun run scripts/seed.ts",
    "reset:data": "bun run scripts/reset-demo.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:http": "bun run scripts/smoke-http.ts",
    "verify": "bun --no-env-file scripts/qualify.ts source",
    "verify:all": "bun --no-env-file scripts/qualify.ts all",
    "test:compiled": "bun --no-env-file scripts/qualify.ts compiled",
    "test:docker": "bun --no-env-file scripts/qualify.ts container",
    "eval:offline": "bun run scripts/eval-offline.ts",
    "eval:fixtures": "bun run scripts/eval-fixtures.ts",
    "eval:live": "bun run scripts/eval-live.ts",
    "eval:query-ab": "bun run scripts/eval-query-ab.ts",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "antd": "^6.6.6",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
